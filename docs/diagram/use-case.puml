@startuml
title MoneyOrgTrack — диаграмма вариантов использования

left to right direction
skinparam packageStyle rectangle

actor "Администратор" as admin
actor "Руководитель" as manager
actor "Сотрудник" as employee

rectangle "MoneyOrgTrack" {
    usecase "Вход в систему" as UC_LOGIN
    usecase "Добавить пользователя" as UC_ADD_USER
    usecase "Удалить пользователя" as UC_DELETE_USER
    usecase "Просмотр списка доходов" as UC_INCOMES
    usecase "Просмотр списка расходов" as UC_EXPENSES
    usecase "Добавление / удаление\nпункта доходов" as UC_INCOME_ITEM
    usecase "Добавление / удаление\nпункта расходов" as UC_EXPENSE_ITEM
    usecase "Изменение суммы\nдоходов / расходов" as UC_CHANGE_AMOUNT
    usecase "Расчёт доходов за месяц" as UC_REPORT
    usecase "Сохранение изменений" as UC_SAVE
    usecase "Экспорт данных" as UC_EXPORT
}

admin --> UC_LOGIN
admin --> UC_ADD_USER
admin --> UC_DELETE_USER
admin --> UC_INCOMES
admin --> UC_EXPENSES
admin --> UC_REPORT
admin --> UC_EXPORT

manager --> UC_LOGIN
manager --> UC_INCOMES
manager --> UC_EXPENSES
manager --> UC_INCOME_ITEM
manager --> UC_EXPENSE_ITEM
manager --> UC_CHANGE_AMOUNT
manager --> UC_REPORT
manager --> UC_SAVE
manager --> UC_EXPORT

employee --> UC_LOGIN
employee --> UC_INCOMES
employee --> UC_EXPENSES
employee --> UC_REPORT
employee --> UC_EXPORT

UC_INCOME_ITEM ..> UC_SAVE : <<include>>
UC_EXPENSE_ITEM ..> UC_SAVE : <<include>>
UC_CHANGE_AMOUNT ..> UC_SAVE : <<include>>

@enduml
