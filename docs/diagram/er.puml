@startuml
title MoneyOrgTrack — ER-диаграмма (по скриншоту)

hide circle
skinparam linetype ortho

entity Role {
  * roleID : int <<PK>>
  --
  * name : str
}

entity ItemType {
  * itemTypeID : int <<PK>>
  --
  * name : str
}

entity User {
  * userID : int <<PK>>
  --
  * name : str
  * login : str
  * passwordHash : str
  * roleID : int <<FK>>
}

entity FinancialItem {
  * itemID : int <<PK>>
  --
  * userID : int <<FK>>
  * itemTypeID : int <<FK>>
  * name : str
  * amount : decimal
  * createdAt : datetime
  * updatedAt : datetime
}

entity OperationLog {
  * logID : int <<PK>>
  --
  * userID : int <<FK>>
  * action : str
  * details : str
  * createdAt : datetime
}

entity MonthlyReport {
  * reportID : int <<PK>>
  --
  * userID : int <<FK>>
  * month : date
  * incomeSum : decimal
  * expenseSum : decimal
  * profit : decimal
  * createdAt : datetime
}

Role ||--o{ User : "имеет роли"
ItemType ||--o{ FinancialItem : "классифицирует"
User ||--o{ FinancialItem : "создаёт"
User ||--o{ OperationLog : "журналирует"
User ||--o{ MonthlyReport : "формирует"

@enduml
